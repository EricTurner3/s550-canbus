  "UpdateMessages": [
    {
      "Message": {
        "JSExt": 0,
        "Interpreter": 1,
        "Expression": "var mps = p('SpeedMph', 0) * 0.44704;\r\n// 0x204 RPM, gauge 0 - 4000 scaled to the game's redline\r\nvar rpm = p('Rpms', 0), max = p('MaxRpm', 8000) || 8000;\r\nvar r = clamp(4000 * rpm / max, 0, 4000);\r\n// 0x202 speed, MPH * 175\r\nvar s = clamp(p('SpeedMph', 0) * 175, 0, 0xFFFF);\r\nvar v = clamp(p('SpeedMph', 0) * 175, 0, 0x3FFF);                    // 0x77 / 0x415, 14 bit\r\nvar w = clamp(p('SpeedMph', 0) * 144, 0, 0x1FFF) & ~0x3;             // 0x217, low 2 bits 0\r\n// g meter, m/s^2\r\nvar lat = LAT_SIGN * mps * p('OrientationYawVelocity', 0) * Math.PI / 180;\r\nvar now = Date.now();\r\nif (lastTime !== null && now > lastTime) lon += (LONG_SIGN * (mps - lastSpeed) * 1000 / (now - lastTime) - lon) * LONG_SMOOTHING;\r\nlastSpeed = mps; lastTime = now;\r\n// 0x92 accelerometer: three 13 bit (m/s^2 + 40) * 100 with 0x6_ on top, byte 7 counter +5, byte 6 checksum\r\naccelCounter = (accelCounter + 5) & 0xFF;\r\nvar a = [];\r\n[lat, lon, 9.7].forEach(function (v) { var v13 = clamp((v + 40) * 100, 0, 0x1FFF); a.push(0x60 | v13 >> 8, v13 & 0xFF); });\r\na.push(0, accelCounter);\r\na[6] = (0x16 - a.reduce(function (x, y) { return x + y; }, 0)) & 0xFF;\r\n// 0x76 steering center + Track Apps g meter: byte 2 = 16 + x * 8, bytes 3 & 4 = 1024 + y * 512, g, +-1.5\r\nvar gx = Math.max(-1.5, Math.min(1.5, lat / 9.81)), gy = Math.max(-1.5, Math.min(1.5, lon / 9.81));\r\nvar gyRaw = 1024 + Math.trunc(gy * 512);\r\nreturn out(frame(0x204, [0xC0, 0x69, 0x7D, r >> 8, r & 0xFF, 0, 0, 0])\r\n     + frame(0x167, [0x72, 0x7F, 0x4B, 0x00, 0x00, 0x1A, 0xED, 0x00])\r\n     + frame(0x92, a)\r\n     + frame(0x202, [0, 0, 0, 0, 0x60, 0, s >> 8, s & 0xFF])\r\n     + frame(0x76, [0x3E, 0x80, 16 + Math.trunc(gx * 8), gyRaw >> 8, gyRaw & 0xFF, 0, 0, 0])\r\n     // chassis messages (interactive_brute_force.py --dummydata). Every speed signal comes from the same game speed,\r\n     // wheel speeds that disagree with vehicle speed trip Hill Start Assist Not Available\r\n     + frame(0x217, [w >> 8, w & 0xFF, w >> 8, w & 0xFF, w >> 8, w & 0xFF, w >> 8, w & 0xFF])  // wheel speeds, MPH * 144\r\n     + frame(0x77, [v >> 8, v & 0xFF, 0x08, 0x00, 0x7F, 0xF7, 0xE6, 0x02])   // speed, byte 6 E6 keeps HSA quiet\r\n     + frame(0x415, [v >> 8, v & 0xFF, 0xD0, 0xFA, 0x07, 0xFD, 0x07, 0xFD])  // speed\r\n     + frame(0x85, [0x7C, 0xFF, 0x80, 0x00, 0x7A, 0x40, 0x7C, 0xEA])         // steering angle\r\n     + frame(0x91, [0x7E, 0xE3, 0x7F, 0x39, 0x3D, 0x93, 0xF0, 0x00])         // yaw rate\r\n     + frame(0x200, [0x00, 0x00, 0x80, 0x47, 0x80, 0x47, 0x00, 0x00])        // engine torque\r\n     + frame(0x82, [0x5C, 0x00, 0x14, 0x98, 0xAF, 0x00, 0x44, 0xFF])         // steering mode\r\n     + frame(0x230, [0xF0, 0x1C, 0x00, 0x00, 0x4B, 0x00, 0x00, 0x00]));       // gear\r\n",
        "PreExpression": "// helpers, slcan transmit frame: t + 3 hex ID + length + data hex + CR\r\nfunction hx(v, n) { return Math.max(0, Math.round(v)).toString(16).toUpperCase().padStart(n, '0').slice(-n); }\r\nfunction frame(id, bytes) { return 't' + hx(id, 3) + bytes.length + bytes.map(b => hx(b, 2)).join('') + '\\r'; }\r\n// SimHub only sends a message when its text changes (the Hz setting is a maximum). Rotating the frame order makes\r\n// every call different, so static frames like 0x3B3 keep going out and the cluster stays awake\r\nvar sendCount = 0;\r\nfunction out(text) {\r\n    var CR = String.fromCharCode(13);\r\n    var frames = text.split(CR).filter(function (f) { return f; });\r\n    var k = sendCount++ % frames.length;\r\n    return frames.slice(k).concat(frames.slice(0, k)).join(CR) + CR;\r\n}\r\nfunction clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, Math.round(v))); }\r\n// any property as a number (true / false -> 1 / 0), or the fallback when the game doesn't send it\r\nfunction raw(name, fallback) { var v = $prop(name); if (v === null || v === undefined || v === '') return fallback; v = Number(v); return isNaN(v) ? fallback : v; }\r\n// game property, DataCorePlugin.GameData.<name>\r\nfunction p(name, fallback) { return raw('DataCorePlugin.GameData.' + name, fallback); }\r\n// game temperature in Celsius, SimHub gives it in the unit picked in its settings\r\nfunction celsius(v) { return $prop('TemperatureUnit') === 'Fahrenheit' ? (v - 32) * 5 / 9 : v; }\r\n// g meter, worked out from speed and yaw rate so it works in any game:\r\n//   lateral = speed * yaw rate (OrientationYawVelocity, deg/s, positive turning left)\r\n//   longitudinal = change in speed, smoothed\r\n// The dot shows the force the driver feels. Flip a sign if it moves the wrong way\r\nvar LAT_SIGN = 1, LONG_SIGN = 1;\r\nvar LONG_SMOOTHING = 0.15;                    // 0 - 1, lower is smoother\r\nvar accelCounter = 0, lastSpeed = null, lastTime = null, lon = 0;\r\n"
      },
      "IsEnabled": true,
      "MaximumFrequency": 60
    },
    {
      "Message": {
        "JSExt": 0,
        "Interpreter": 1,
        "Expression": "// 0x179, byte 5 distance counter\r\nvar now = Date.now();\r\nif (odometerTime !== null) odometerCounts += p('SpeedMph', 0) * (now - odometerTime) / 3600000 * ODOMETER_COUNTS_PER_MILE;\r\nodometerTime = now;\r\n// 0x416 traction control / ABS icons\r\nvar tc = p('TCActive', 0) ? 0x0F : 0x00;      // flashing\r\nvar abs = p('ABSActive', 0) ? 0xD0 : 0x00;    // flashing\r\n// 0x156 coolant / oil, raw - 60 = Celsius. Defaults keep the needles normal for games that don't send them\r\nvar water = p('WaterTemperature', 0), oilTemp = p('OilTemperature', 0);\r\nvar coolant = clamp((water ? celsius(water) : 110) + 60, 0, 0xFF);\r\nvar oil = clamp((oilTemp ? celsius(oilTemp) : 100) + 60, 0, 0xFF);\r\n// 0x43E AFR, cylinder head temp, boost\r\nvar AFR = 14.7, CHT = 99;                     // no game sends these\r\nvar boostPsi = p('Turbo', 0) * 14.5;          // SimHub Turbo in bar -> psi, negative is vacuum\r\nvar boost = clamp((boostPsi * 6.895 + 206.9) * 10, 0, 0x1FFF) << 3;\r\nreturn out(frame(0x179, [0x00, 0x00, 0x00, 0x00, 0x96, Math.trunc(odometerCounts) % 256, 0x02, 0xC8])\r\n     + frame(0x4C, [0x10, 0x5F, 0xFF, 0x00, 0x00, 0x00, 0x00, 0x00])            // seatbelt off\r\n     + frame(0x416, [0x00, 0x00, 0x00, 0x00, 0x00, tc, abs, 0x00])\r\n     + frame(0x178, [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00])            // launch control off\r\n     + frame(0x156, [coolant, oil, 0x00, 0x00, 0x03, 0x00, 0x00, 0x00])\r\n     + frame(0x326, [0x81, 0x95, 0x02, 0x4A, 0x01, 0xAA, 0x00, 0x00])\r\n     + frame(0x35E, [0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x30, 0x00])\r\n     + frame(0x44, [0x88, 0xC0, 0x0C, 0x10, 0x04, 0x00, 0x02, 0x00])\r\n     + frame(0x48, [0x00, 0x00, 0x00, 0x00, 0x07, 0x00, 0xE0, 0x00])\r\n     + frame(0x109, [0x00, 0x03, 0x01, 0x00, 0x00, 0x00, 0x00, 0x28])\r\n     + frame(0x43E, [0x00, 0x93, 0x10, clamp(AFR * 10, 0, 0xFF), clamp(CHT + 60, 0, 0xFF), boost >> 8, boost & 0xFF, 0x00])\r\n     + frame(0x421, [0x00, 0x00, 0x50, 0x00, 0x00, 0x00, 0x4D, 0x00])        // oil pressure normal, no check engine\r\n     + frame(0x3E3, [0x00, 0x01, 0x04, REPLIES[replyIndex++ % REPLIES.length], 0x80, 0x00, 0x00, 0x00])\r\n     + frame(0x3E6, [0x00, 0x01, 0x04, 0x07, 0x80, 0x00, 0x00, 0x00]));\r\n",
        "PreExpression": "// helpers, slcan transmit frame: t + 3 hex ID + length + data hex + CR\r\nfunction hx(v, n) { return Math.max(0, Math.round(v)).toString(16).toUpperCase().padStart(n, '0').slice(-n); }\r\nfunction frame(id, bytes) { return 't' + hx(id, 3) + bytes.length + bytes.map(b => hx(b, 2)).join('') + '\\r'; }\r\n// SimHub only sends a message when its text changes (the Hz setting is a maximum). Rotating the frame order makes\r\n// every call different, so static frames like 0x3B3 keep going out and the cluster stays awake\r\nvar sendCount = 0;\r\nfunction out(text) {\r\n    var CR = String.fromCharCode(13);\r\n    var frames = text.split(CR).filter(function (f) { return f; });\r\n    var k = sendCount++ % frames.length;\r\n    return frames.slice(k).concat(frames.slice(0, k)).join(CR) + CR;\r\n}\r\nfunction clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, Math.round(v))); }\r\n// any property as a number (true / false -> 1 / 0), or the fallback when the game doesn't send it\r\nfunction raw(name, fallback) { var v = $prop(name); if (v === null || v === undefined || v === '') return fallback; v = Number(v); return isNaN(v) ? fallback : v; }\r\n// game property, DataCorePlugin.GameData.<name>\r\nfunction p(name, fallback) { return raw('DataCorePlugin.GameData.' + name, fallback); }\r\n// game temperature in Celsius, SimHub gives it in the unit picked in its settings\r\nfunction celsius(v) { return $prop('TemperatureUnit') === 'Fahrenheit' ? (v - 32) * 5 / 9 : v; }\r\n// replies to the cluster's 0x3E0 startup requests (interactive_brute_force.py --respond). SimHub can't read the\r\n// requests, so 0x3E3 cycles through every answer, the cluster repeats a request for 5s until one matches.\r\n// 04 07 is answered on 0x3E6 and held, like the GT350\r\nvar REPLIES = [0x01, 0x03, 0x04, 0x05, 0x0D, 0x10, 0x11];\r\nvar replyIndex = 0;\r\n// odometer distance counter, ~8767 counts a mile. Set to 0 to keep game miles off the odometer\r\nvar ODOMETER_COUNTS_PER_MILE = 8767;\r\nvar odometerCounts = 0, odometerTime = null;\r\n"
      },
      "IsEnabled": true,
      "MaximumFrequency": 10
    },
    {
      "Message": {
        "JSExt": 0,
        "Interpreter": 1,
        "Expression": "// 0x3B3 keeps the cluster on (byte 0 0x4_), 0x3B2 unlocks Track Apps and carries the turn signals\r\nvar brake = p('Handbrake', 0) > 0 ? 0xC0 : 0x00;\r\n// only a real 1 / true lights them, set SIGNALS = false to turn them off\r\nvar right = SIGNALS && p('TurnIndicatorRight', 0) === 1 ? 0x08 : 0x00;\r\nvar left = SIGNALS && p('TurnIndicatorLeft', 0) === 1 ? 0x40 : 0x00;\r\n// 0x42D intake air temp, (Celsius + 128) * 4\r\nvar iat = clamp((22 + 128) * 4, 0, 0x3FF);    // 72f, no game sends it\r\nreturn out(frame(0x3B3, [0x40, 0x48, 0x02, 0x0A, 0x10, 0x05, brake, 0x02])\r\n     + frame(0x3B2, [0x40, 0x00, 0x00, 0x12, 0x10 | right, 0x00, left, 0x02])\r\n     + frame(0x42D, [0x00, iat >> 8, iat & 0xFF, 0x00, 0x00, 0x00, 0xF0, 0x00]));\r\n",
        "PreExpression": "// helpers, slcan transmit frame: t + 3 hex ID + length + data hex + CR\r\nfunction hx(v, n) { return Math.max(0, Math.round(v)).toString(16).toUpperCase().padStart(n, '0').slice(-n); }\r\nfunction frame(id, bytes) { return 't' + hx(id, 3) + bytes.length + bytes.map(b => hx(b, 2)).join('') + '\\r'; }\r\n// SimHub only sends a message when its text changes (the Hz setting is a maximum). Rotating the frame order makes\r\n// every call different, so static frames like 0x3B3 keep going out and the cluster stays awake\r\nvar sendCount = 0;\r\nfunction out(text) {\r\n    var CR = String.fromCharCode(13);\r\n    var frames = text.split(CR).filter(function (f) { return f; });\r\n    var k = sendCount++ % frames.length;\r\n    return frames.slice(k).concat(frames.slice(0, k)).join(CR) + CR;\r\n}\r\nfunction clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, Math.round(v))); }\r\n// any property as a number (true / false -> 1 / 0), or the fallback when the game doesn't send it\r\nfunction raw(name, fallback) { var v = $prop(name); if (v === null || v === undefined || v === '') return fallback; v = Number(v); return isNaN(v) ? fallback : v; }\r\n// game property, DataCorePlugin.GameData.<name>\r\nfunction p(name, fallback) { return raw('DataCorePlugin.GameData.' + name, fallback); }\r\n// game temperature in Celsius, SimHub gives it in the unit picked in its settings\r\nfunction celsius(v) { return $prop('TemperatureUnit') === 'Fahrenheit' ? (v - 32) * 5 / 9 : v; }\r\nvar SIGNALS = true;\r\n"
      },
      "IsEnabled": true,
      "MaximumFrequency": 5
    },
    {
      "Message": {
        "JSExt": 0,
        "Interpreter": 1,
        "Expression": "// 0x3C3 high beams / parking brake\r\n// ATS / ETS2 only, Forza doesn't report its lights\r\nvar high = raw('GameRawData.TruckValues.CurrentValues.LightsValues.BeamHigh', 0) ? 0x4E : 0x4C;\r\nvar brake = p('Handbrake', 0) > 0 ? 0x10 : 0x00;\r\n// 0x3B5 tire pressure, 16 bit kPa per tire\r\nvar t = [];\r\n['FrontLeft', 'FrontRight', 'RearRight', 'RearLeft'].forEach(function (tire) {\r\n    var kpa = clamp(psi(p('TyrePressure' + tire, 0)) * 6.895, 0, 0xFFFF); t.push(kpa >> 8, kpa & 0xFF);\r\n});\r\nreturn out(frame(0x3C3, [high, 0x48, brake, 0x01, 0x00, 0x00, 0x00, 0x00])\r\n     + frame(0x3B5, t)\r\n     + frame(0x581, [0x81, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF])           // module alive frames\r\n     + frame(0x596, [0x96, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF])\r\n     + frame(0x59E, [0x9E, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF])\r\n     + frame(0x5B3, [0xB3, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF])\r\n     + frame(0x5B5, [0xB5, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF, 0xFF]));\r\n",
        "PreExpression": "// helpers, slcan transmit frame: t + 3 hex ID + length + data hex + CR\r\nfunction hx(v, n) { return Math.max(0, Math.round(v)).toString(16).toUpperCase().padStart(n, '0').slice(-n); }\r\nfunction frame(id, bytes) { return 't' + hx(id, 3) + bytes.length + bytes.map(b => hx(b, 2)).join('') + '\\r'; }\r\n// SimHub only sends a message when its text changes (the Hz setting is a maximum). Rotating the frame order makes\r\n// every call different, so static frames like 0x3B3 keep going out and the cluster stays awake\r\nvar sendCount = 0;\r\nfunction out(text) {\r\n    var CR = String.fromCharCode(13);\r\n    var frames = text.split(CR).filter(function (f) { return f; });\r\n    var k = sendCount++ % frames.length;\r\n    return frames.slice(k).concat(frames.slice(0, k)).join(CR) + CR;\r\n}\r\nfunction clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, Math.round(v))); }\r\n// any property as a number (true / false -> 1 / 0), or the fallback when the game doesn't send it\r\nfunction raw(name, fallback) { var v = $prop(name); if (v === null || v === undefined || v === '') return fallback; v = Number(v); return isNaN(v) ? fallback : v; }\r\n// game property, DataCorePlugin.GameData.<name>\r\nfunction p(name, fallback) { return raw('DataCorePlugin.GameData.' + name, fallback); }\r\n// game temperature in Celsius, SimHub gives it in the unit picked in its settings\r\nfunction celsius(v) { return $prop('TemperatureUnit') === 'Fahrenheit' ? (v - 32) * 5 / 9 : v; }\r\n// psi, used for a tire the game doesn't report (0)\r\nvar TIRE_PSI_DEFAULT = 30;\r\n// SimHub's tire pressure in psi. Over 100 is taken as kPa, under 5 as bar\r\nfunction psi(v) { return !v ? TIRE_PSI_DEFAULT : v > 100 ? v / 6.895 : v < 5 ? v * 14.504 : v; }\r\n"
      },
      "IsEnabled": true,
      "MaximumFrequency": 5
    }
